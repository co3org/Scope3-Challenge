{
  "theme": "base",
  "themeVariables": {
    "fontFamily": "'Inter','Segoe UI',system-ui,-apple-system,'Helvetica Neue',Arial,sans-serif",
    "fontSize": "14px",
    "background": "#ffffff",
    "primaryColor": "#f8fafc",
    "primaryTextColor": "#1f2937",
    "primaryBorderColor": "#cbd5e1",
    "lineColor": "#94a3b8",
    "secondaryColor": "#f1f5f9",
    "tertiaryColor": "#f8fafc",
    "clusterBkg": "#f8fafc",
    "clusterBorder": "#e2e8f0",
    "titleColor": "#0f172a",
    "edgeLabelBackground": "#ffffff",
    "nodeBorder": "#cbd5e1",
    "nodeTextColor": "#1f2937",
    "mainBkg": "#f8fafc",
    "noteBkgColor": "#fff9db",
    "noteTextColor": "#5c4400",
    "noteBorderColor": "#f08c00"
  },
  "flowchart": {
    "htmlLabels": true,
    "curve": "linear",
    "nodeSpacing": 30,
    "rankSpacing": 44,
    "padding": 12,
    "useMaxWidth": false
  },
  "sequence": {
    "actorMargin": 50,
    "messageMargin": 38,
    "useMaxWidth": false
  },
  "gantt": {
    "useMaxWidth": false
  },
  "pie": {
    "textPosition": 0.72,
    "useMaxWidth": false
  },
  "quadrantChart": {
    "useMaxWidth": false
  },
  "xyChart": {
    "useMaxWidth": false
  },
  "timeline": {
    "useMaxWidth": false
  }
}
