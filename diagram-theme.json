{
  "theme": "base",
  "themeVariables": {
    "fontFamily": "'Inter','Segoe UI',system-ui,-apple-system,'Helvetica Neue',Arial,sans-serif",
    "fontSize": "15px",
    "background": "#ffffff",
    "primaryColor": "#eef7f3",
    "primaryTextColor": "#0f2b22",
    "primaryBorderColor": "#2f9e6e",
    "lineColor": "#6b8a7e",
    "secondaryColor": "#e7f2ee",
    "tertiaryColor": "#f5f9f7",
    "clusterBkg": "#f7fbf9",
    "clusterBorder": "#d5e7df",
    "titleColor": "#0f2b22",
    "edgeLabelBackground": "#ffffff",
    "nodeBorder": "#2f9e6e",
    "nodeTextColor": "#0f2b22",
